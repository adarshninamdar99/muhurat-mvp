# ─────────────────────────────────────────────────────────────
# Muhurat settings. Copy this file to `.env.local` and fill it in.
# ─────────────────────────────────────────────────────────────

# Which AI service makes the pictures and clips.
#   mock       = built-in demo mode, no account or cost (storyboard sketches)
#   cloudflare = FREE real AI pictures on Cloudflare Workers AI (about 80 a day).
#                Needs the two CLOUDFLARE_ settings below. See docs/FREE_AI_SETUP.md
#   fal        = paid real AI on fal.ai: pictures, real depth and real video (needs FAL_KEY)
AI_PROVIDER=mock

# Cloudflare (free). Account ID and an API token with "Workers AI" permission.
# Step-by-step: docs/FREE_AI_SETUP.md. Keep the token secret: never commit it or send it on chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# fal.ai API key (paid). Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Address phones use to open the family link (leave empty on your own computer:
# the app uses your Wi-Fi address so a phone on the same Wi-Fi can open it).
# On a real server, set it, e.g. https://preview.aloverscard.com
PUBLIC_BASE_URL=

# Where the SQLite database file lives.
DATABASE_PATH=./data/muhurat.db

# Where uploaded photos and generated pictures are saved.
STORAGE_DIR=./data/files

# Password for the admin page (/admin). Username is "admin".
ADMIN_PASSWORD=change-me

# Rupees per US dollar, used to show costs in ₹.
USD_TO_INR=88

# How many AI jobs run at the same time.
JOB_CONCURRENCY=2
